---
import { getCollection } from "astro:content";
import BaseLayout from "src/layouts/BaseLayout.astro";

const details = await getCollection("details");

interface Props {
  error: unknown;
}
const { error } = Astro.props;
---

<BaseLayout
  title="Error 500: Internal Server Error"
  description={"Error 500: Internal Server Error - " +
    details[0].data.name +
    " - " +
    details[0].data.description}
>
  {/* Error Section */}
  <section id="error-500" class="relative pt-20 pb-32">
    <div class="z-10 relative mx-auto px-6 container">
      <div class="flex justify-center items-center mx-auto mb-12 max-w-[1320px] text-center align-middle">
        <h1
          id="Error 500"
          class="flex items-center gap-2 px-4 font-bold text-blue-400 text-center"
        >
          <span>Error 500: <br />Internal Server Error</span>
        </h1>
      </div>
      <div class="text-center">
        <p class="mx-auto mt-4 max-w-xl">
          {
            error instanceof Error
              ? error.message
              : "The server encountered an error or misconfiguration and was unable to complete your request."
          }
        </p>
        <p class="mx-auto mt-6 max-w-xl">
          Please check the URL or return to the <a
            href="/"
            title="Go to homepage"
            >homepage</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
