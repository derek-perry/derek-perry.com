---
import { getCollection } from "astro:content";
import BaseLayout from "src/layouts/BaseLayout.astro";
import { marked } from "marked";

export async function getStaticPaths() {
    const work = await getCollection("work");
    return work.map((work) => ({
        params: { slug: work.slug },
        props: { work: work },
    }));
}

const { work } = Astro.props;
const content = await marked.parse(
    work.body && work.body.trim()
        ? work.body.replace(/\n(?=\n)/g, "\n\n<br/>\n")
        : "",
);

const details = await getCollection("details");

const envDomain = import.meta.env.SITE_URL?.trim();
const domain = envDomain
    ? envDomain
    : "https://" + details[0].data.domain.toLowerCase();
---

<BaseLayout
    title={work.data.title}
    description={work.body && work.body.trim()
        ? work.body
              .split(" ")
              .slice(0, 40)
              .join(" ")
              .replace(/[#*_\`]/g, "")
              .replace(/\[([^\]]+)\]\([^\)]+\)/g, "$1")
              .trim() + (work.body.split(" ").length > 40 ? "..." : "")
        : ""}
    image={work.data.image
        ? typeof work.data.image === "object"
            ? `${domain}${work.data.image.src}`
            : `${domain}${work.data.image}`
        : undefined}
>
    <article
        id="work"
        class="flex flex-col gap-4 mx-auto mt-12 px-6 pt-6 max-[460px]:pt-10 pb-32 max-w-3xl container"
    >
        <section
            id="work-details"
            class="flex flex-col justify-center items-center gap-4 mb-4 text-center"
        >
            <h1 id={work.data.title}>{work.data.title}</h1>
        </section>
        <section
            id="work-content"
            class="flex flex-col justify-left items-stretch gap-2 mx-auto max-w-3xl text-left"
        >
            <p set:html={content} />
        </section>
    </article>
</BaseLayout>
