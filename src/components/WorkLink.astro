---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export interface Props {
    work: CollectionEntry<"work">;
    index: number;
}

const { work, index } = Astro.props;
---

<a
    id={"work-" + index}
    href={"/" + work.slug}
    title={work.data.title}
    class="group block max-w-2xl no-underline hover:no-underline hover:scale-105 transition-transform transform"
>
    <div
        class="flex flex-col items-center gap-6 bg-[#242929] shadow-lg hover:shadow-xl p-4 transition-all"
    >
        <div class="flex md:flex-row flex-col items-center gap-4 w-full">
            {
                work.data.image ? (
                    <picture>
                        {typeof work.data.image === "object" ? (
                            <Image
                                src={work.data.image}
                                alt={work.data.title}
                                width={work.data.image.width}
                                height={work.data.image.height}
                                decoding="async"
                                class="w-full h-auto"
                            />
                        ) : (
                            <img
                                src={work.data.image}
                                alt={work.data.title}
                                width={350}
                                height={350}
                                decoding="async"
                                class="w-full h-auto"
                            />
                        )}
                    </picture>
                ) : (
                    <div class="flex flex-col items-center gap-4 my-4 w-full">
                        <h3 class="font-extrabold text-[#689915] group-focus:text-white group-hover:text-white text-2xl text-center transition-colors duration-200">
                            {work.data.title}
                        </h3>
                    </div>
                )
            }
        </div>
    </div>
</a>
