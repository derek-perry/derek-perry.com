---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@fontsource-variable/saira";
import sairaWoff2 from "@fontsource-variable/saira/files/saira-latin-wght-normal.woff2?url";

import "@styles/globals.css";

const { description, title, image } = Astro.props;
const details = await getCollection("details");

const envDomain = import.meta.env.SITE_URL?.trim();
const domain = envDomain ? envDomain : ("https://" + details[0].data.domain.toLowerCase());

const titleClean = Astro.url.pathname === "/" ? `${details[0].data.name} - ${details[0].data.tagline}` : `${title} | ${details[0].data.name}`
---

<html lang="en">
  <head>
    <ClientRouter />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={sairaWoff2}
      crossorigin="anonymous"
    />

    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />

    <meta
      name="keywords"
      content={details[0].data.keywords && details[0].data.keywords.length > 0
        ? details[0].data.keywords.join(", ")
        : ""}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="canonical"
      href={`${domain}${Astro.url.pathname}`}
    />
    <title>{titleClean}</title>
    <meta property="og:title" content={titleClean} />
    <meta property="og:site_name" content={titleClean} />
    <meta name="application-name" content={titleClean} />
    <meta name="apple-mobile-web-app-title" content={titleClean} />
    <meta name="twitter:title" content={titleClean} />

    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta name="twitter:description" content={description} />

    <meta
      property="og:url"
      content={`${domain}${Astro.url.pathname}`}
    />
    
    {(image && image != undefined) ? (
      <meta property="og:image" content={image} />
      <meta
        property="og:image:secure_url"
        content={image}
      />
      <meta name="twitter:image" content={image} />
    ) : (
      <meta property="og:image" content={`${domain}/banner.png`} />
      <meta
        property="og:image:secure_url"
        content={`${domain}/banner.png`}
      />
      <meta name="twitter:image" content={`${domain}/banner.png`} />
    )}
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={titleClean} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:width" content="1920" />
    <meta name="twitter:image:height" content="1080" />
    <meta name="twitter:image:alt" content={titleClean} />

    <link
      rel="icon"
      type="image/png"
      href={`${domain}/favicon-96x96.png`}
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href={`${domain}/favicon.svg`} />
    <link rel="shortcut icon" href={`${domain}/favicon.ico`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${domain}/apple-touch-icon.png`}
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#689915" />

    <script
      defer
      data-domain={details[0].data.domain.toLowerCase()}
      src="https://plausible.io/js/plausible.js"></script>
  </head>
  <body
    class="flex flex-col justify-between min-h-screen font-sans align-middle"
  >
    <a class="skip" aria-label="skip to main content" href="#main"
      >Click To Skip To Main Content</a
    >
    <Header />
    <main
      id="main"
      role="main"
      class="flex flex-col flex-1 justify-center align-middle grow"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
